# Cabinet Bouche & Chmura — bilan-mdph.fr
# Protection d'accès en phase privée (avant validation par le cabinet et mise en ligne publique).
# Mécanisme : gate.php + cookie, appliqué côté serveur via mod_rewrite (aucune vérification en
# JavaScript côté client). Voir NOTE-DE-LIVRAISON.md pour la procédure de retrait au passage en public.

RewriteEngine On
RewriteBase /

# Fichiers toujours accessibles sans mot de passe : la page de connexion elle-même,
# les assets techniques (CSS/JS/polices) et robots.txt (lu par les robots avant tout)
RewriteCond %{REQUEST_URI} ^/gate\.php$ [OR]
RewriteCond %{REQUEST_URI} ^/robots\.txt$ [OR]
RewriteCond %{REQUEST_URI} ^/assets/
RewriteRule ^ - [L]

# Tout le reste exige le cookie posé par gate.php après saisie du bon mot de passe
# (mot de passe de Max OU mot de passe restreint d'une collaboratrice — deux valeurs
# de cookie possibles, voir gate.php).
RewriteCond %{HTTP_COOKIE} !bmdph_gate=c74f96e7453df185ebd571aa6990dff8bd19201fdb4d9b17
RewriteCond %{HTTP_COOKIE} !bmdph_gate=d479e1f46927f514ef2deecd9af37567232b56745189fc2b
RewriteRule ^(.*)$ /gate.php?r=%{REQUEST_URI} [L,QSA]

# Une fois authentifié avec le cookie de Max (cookie déjà présent, cas de Max qui revient
# plusieurs fois), l'adresse nue (racine, "/") doit toujours mener au portail des 4 sites,
# jamais à la page d'accueil du site Bilan MDPH.
RewriteCond %{HTTP_COOKIE} bmdph_gate=c74f96e7453df185ebd571aa6990dff8bd19201fdb4d9b17
RewriteRule ^$ /portail.html [L]

# Accès restreint (cookie collaboratrice) : jamais le portail, ni via l'adresse nue,
# ni en tapant /portail.html directement — toujours renvoyé vers la page d'accueil
# du site Bilan MDPH.
RewriteCond %{HTTP_COOKIE} bmdph_gate=d479e1f46927f514ef2deecd9af37567232b56745189fc2b
RewriteRule ^(|portail\.html)$ /index.html [L]

# Pages livrées en fichier plat (nom-de-page.html) mais servies avec une URL propre
# (nom-de-page/), pour permettre un dépôt en un seul geste sur GitHub sans passer par
# des sous-dossiers imbriqués. Ne s'applique qu'une fois le mot de passe validé (la
# règle ci-dessus a laissé passer la requête).
# Étape 1 : une URL avec un / final est d'abord ramenée sans le / (le serveur ne sait
# pas toujours appliquer la règle suivante quand l'URL se termine par un /).
RewriteRule ^(aidants-et-proches|bilan-en-deux-jours|bilan-mdph-adulte|bilan-neuropsychologique-mdph|bilan-neuropsychologique-personne-agee|bilan-orthopedagogique-mdph|bilan-psychologique-mdph|certificat-medical-mdph|checklist-dossier-mdph-2026|confidentialite|dossier-mdph-adulte|equipe|handicap-cognitif-mdph|handicap-invisible-rqth|handicap-psychique-mdph|handicap-vieillissant|lieux-de-consultation|mdph-apres-60-ans|mentions-legales|pieces-a-joindre-dossier-mdph|prendre-rendez-vous|prix-bilan-mdph|projet-de-vie-mdph|questionnaire-complementaire-tnd|reforme-formulaire-mdph-2026|retentissement-fonctionnel|tdah-adulte-mdph|tdah-rqth)/$ /$1 [R=301,L]
# Étape 2 : une fois sans le /, on sert le vrai fichier .html correspondant.
RewriteRule ^(aidants-et-proches|bilan-en-deux-jours|bilan-mdph-adulte|bilan-neuropsychologique-mdph|bilan-neuropsychologique-personne-agee|bilan-orthopedagogique-mdph|bilan-psychologique-mdph|certificat-medical-mdph|checklist-dossier-mdph-2026|confidentialite|dossier-mdph-adulte|equipe|handicap-cognitif-mdph|handicap-invisible-rqth|handicap-psychique-mdph|handicap-vieillissant|lieux-de-consultation|mdph-apres-60-ans|mentions-legales|pieces-a-joindre-dossier-mdph|prendre-rendez-vous|prix-bilan-mdph|projet-de-vie-mdph|questionnaire-complementaire-tnd|reforme-formulaire-mdph-2026|retentissement-fonctionnel|tdah-adulte-mdph|tdah-rqth)$ /$1.html [L]

# Page d'erreur 404 du site (une fois passé le mot de passe)
ErrorDocument 404 /404.html
